# Get a key at https://aistudio.google.com/apikey
# Prototype only: this key ships to the browser. Do not deploy publicly with it.
VITE_GEMINI_API_KEY=your_key_here
# Optional second key for A/B mode: gives arm B its own Lyria stream so
# switching is instant. Without it, A/B switching cuts the single stream.
VITE_GEMINI_API_KEY_B=
